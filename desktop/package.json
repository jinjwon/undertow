{
  "name": "evoke-desktop",
  "productName": "Evoke",
  "version": "2.5.0",
  "private": true,
  "description": "Evoke as a desktop editor: files, Monaco, and Claude Code side by side.",
  "author": "jinjwon",
  "main": "main.cjs",
  "scripts": {
    "postinstall": "node -e \"for (const a of ['arm64','x64']) try { require('fs').chmodSync('node_modules/node-pty/prebuilds/darwin-'+a+'/spawn-helper', 0o755) } catch {}\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist:mac": "vite build && electron-builder --mac dir && sh sign-mac.sh",
    "dist:win": "vite build && electron-builder --win",
    "dist:win:zip": "vite build && electron-builder --win zip --x64",
    "test": "node --test ide.test.cjs paths.test.cjs match.test.cjs serve.test.cjs store.test.cjs src/prefs.test.ts src/docks.test.ts src/text.test.ts src/layout.test.ts src/agents.test.ts src/chat.test.ts src/events.test.ts src/look.test.ts"
  },
  "build": {
    "appId": "dev.evoke.desktop",
    "productName": "Evoke",
    "files": [
      "main.cjs",
      "preload.cjs",
      "paths.cjs",
      "match.cjs",
      "serve.cjs",
      "ide.cjs",
      "store.cjs",
      "dist/**",
      "!node_modules/node-pty/build/**",
      "!node_modules/node-pty/**/*.pdb"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "../assets/icon-tide.png",
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "files": [
        "!node_modules/node-pty/prebuilds/win32-*/**"
      ],
      "extraResources": [
        {
          "from": "../assets/icon-tide.png",
          "to": "icon-tide.png"
        },
        {
          "from": "../assets/icon-rebel.png",
          "to": "icon-rebel.png"
        }
      ]
    },
    "win": {
      "icon": "../assets/logo-tide.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!node_modules/node-pty/prebuilds/darwin-*/**",
        "!node_modules/node-pty/prebuilds/win32-arm64/**"
      ],
      "extraResources": [
        {
          "from": "../assets/logo-tide.png",
          "to": "logo-tide.png"
        },
        {
          "from": "../assets/logo-rebel.png",
          "to": "logo-rebel.png"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Evoke",
      "artifactName": "Evoke-Setup-${version}.${ext}"
    },
    "electronLanguages": [
      "en",
      "ko",
      "ja"
    ],
    "compression": "maximum",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "dependencies": {
    "marked": "^18.2.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.5"
  }
}
